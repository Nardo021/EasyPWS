    "@easypws/core": "workspace:*",
    "@easypws/database": "workspace:*",
    "@easypws/notifications": "workspace:*",
    "@easypws/observability": "workspace:*",
    "@easypws/rules": "workspace:*",
    "@easypws/services": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
