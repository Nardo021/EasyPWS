{
  "name": "@easypws/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "node ../../scripts/workspace.mjs lint"
  },
  "dependencies": {
    "@easypws/adapters": "workspace:*",
