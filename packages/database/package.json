{
  "name": "@easypws/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
    "exports": {
    ".": {
      "easypws-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "node ../../scripts/workspace.mjs lint",
    "migrate": "echo \"Schema applied on process start via ensureSchema() / 001_init.sql\"",
    "test": "node --conditions=easypws-source --import tsx scripts/smoke-bootstrap.mts"
  },
  "dependencies": {
    "@easypws/contracts": "workspace:*",
    "@easypws/core": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
