{
  "name": "easypws",
  "private": true,
  "version": "0.1.0",
  "description": "Easy Price Watch Service — self-hosted multi-retailer price monitoring platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "node scripts/workspace.mjs build",
    "dev": "pnpm --filter @easypws/api dev",
    "dev:api": "pnpm --filter @easypws/api dev",
    "dev:web": "pnpm --filter @easypws/web dev",
    "start": "pnpm --filter @easypws/api start",
    "lint": "node scripts/workspace.mjs lint",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "test": "node scripts/workspace.mjs test",
    "db:migrate": "pnpm --filter @easypws/database migrate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
