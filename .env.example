# EasyPWS single-process LXC defaults
PORT=3000
DATA_DIR=./data
# Or set an absolute DB file path:
# DATABASE_PATH=/var/lib/easypws/easypws.sqlite

# Bootstrap (first boot issues tokens once when true)
BOOTSTRAP_EMAIL=admin@easypws.local
BOOTSTRAP_ISSUE_TOKENS=true
# Optional recovery secret for POST /api/v1/tokens/recover
BOOTSTRAP_ROTATE_SECRET=

# Scheduling / rate limits
MANUAL_REFRESH_COOLDOWN_MS=60000
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_STAGGER_MS=1500

# Coles adapter
COLES_STORE_ID=647
COLES_STORE_NAME=Default Coles Store
COLES_SUBSCRIPTION_KEY=eae83861d1cd4de6bb9cd8a2cd6f041e

# Home Assistant webhook (optional notification channel)
HA_WEBHOOK_URL=

# Public URLs (Cloudflare / Authentik) — informational
PUBLIC_WEB_URL=https://easypws.leoze.top
PUBLIC_API_URL=https://easypws.leoze.top

# Optional: override API base for next dev only (production web uses same-origin "")
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Auth (OIDC via Authentik — configure later)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
