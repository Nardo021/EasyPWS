# EasyPWS local / LXC Docker Compose defaults
POSTGRES_USER=easypws
POSTGRES_PASSWORD=easypws
POSTGRES_DB=easypws
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=3001
WEB_PORT=3000

# Public URLs (Cloudflare / Authentik)
PUBLIC_WEB_URL=https://easypws.leoze.top
PUBLIC_API_URL=https://api.price.leoze.top

# Auth (OIDC via Authentik — configure later)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# HA integration token (scoped, revocable)
HA_API_TOKEN=

# Object storage (optional for MVP scaffold)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
