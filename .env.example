# EasyPWS local / LXC Docker Compose defaults
POSTGRES_USER=easypws
POSTGRES_PASSWORD=easypws
POSTGRES_DB=easypws
POSTGRES_PORT=5432
DATABASE_URL=postgres://easypws:easypws@localhost:5432/easypws

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_PORT=3000

# Bootstrap (first boot issues tokens once when true)
BOOTSTRAP_EMAIL=admin@easypws.local
BOOTSTRAP_ISSUE_TOKENS=true

# Coles adapter
COLES_STORE_ID=647
COLES_STORE_NAME=Default Coles Store
COLES_SUBSCRIPTION_KEY=eae83861d1cd4de6bb9cd8a2cd6f041e

# Home Assistant webhook (optional notification channel)
HA_WEBHOOK_URL=

# Public URLs (Cloudflare / Authentik)
PUBLIC_WEB_URL=https://easypws.leoze.top
PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Auth (OIDC via Authentik — configure later)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
